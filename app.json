{
  "expo": {
    "name": "Palzee",
    "slug": "palzee-ios",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/pal_logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/pal_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F4FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pratham.palzee",
      "entitlements": {
        "aps-environment": null,
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "NSCameraUsageDescription": "Palzee needs access to your camera to capture photos and videos for your daily pal feed.",
        "NSMicrophoneUsageDescription": "Palzee needs access to your microphone to record audio for videos.",
        "NSPhotoLibraryUsageDescription": "Palzee needs access to your photo library to pick images and videos.",
        "NSPhotoLibraryAddUsageDescription": "Palzee needs access to save captured media to your photo library."
      },
      "usesAppleSignIn": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Palzee needs camera permission to capture daily pal moments.",
          "microphonePermission": "Palzee needs access to your microphone to record audio for videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/bricolage_grotesque_variable.ttf",
            "./assets/fonts/courier_prime.ttf",
            "./assets/fonts/dela_gothic_one_regular.ttf",
            "./assets/fonts/google_sans_regular.ttf",
            "./assets/fonts/ibm_plex_mono.ttf",
            "./assets/fonts/jetbrains_mono_regular.ttf",
            "./assets/fonts/ownglyph.ttf",
            "./assets/fonts/roboto_medium_numbers.ttf",
            "./assets/fonts/roboto_mono_regular.ttf",
            "./assets/fonts/roboto_slab_regular.ttf",
            "./assets/fonts/space_mono_regular.ttf",
            "./assets/fonts/unpack.otf"
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Palzee needs access to your photo library to pick images and videos.",
          "savePhotosPermission": "Palzee needs access to save captured media to your photo library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Palzee needs access to your photo library to pick images and videos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/ic_status_bar_silhouette.png",
          "color": "#5218ED",
          "defaultChannel": "default_app_channel"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "./plugins/withAndroidLauncherIcons",
      "./plugins/withFirebaseNotificationMetaOverride",
      [
        "expo-apple-authentication"
      ]
    ],
    "scheme": "io.supabase.pals",
    "android": {
      "package": "com.finrein.pals",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "io.supabase.pals",
              "host": "login-callback"
            }
          ]
        }
      ],
      "versionCode": 1,
      "allowBackup": false
    }
  }
}
